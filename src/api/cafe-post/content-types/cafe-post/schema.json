{
  "kind": "collectionType",
  "collectionName": "cafe_posts",
  "info": {
    "singularName": "cafe-post",
    "pluralName": "cafe-posts",
    "displayName": "cafe-post"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "desc": {
      "type": "blocks"
    },
    "date": {
      "type": "date"
    },
    "views": {
      "type": "integer"
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "contentImages": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    }
  }
}
